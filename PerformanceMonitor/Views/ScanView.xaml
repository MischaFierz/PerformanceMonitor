<UserControl x:Class="PerformanceMonitor.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PerformanceMonitor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">

            <!-- ===== Hero ===== -->
            <Border Style="{StaticResource Card}" Padding="28,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18213A" Offset="0" />
                        <GradientStop Color="#1F1A3A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="164" Height="164">
                        <c:RingGauge x:Name="Ring" Thickness="13" RingBrush="{StaticResource AccentGradient}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="RingValue" Text="?" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="RingLabel" Text="Score" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitle" Text="Was bremst dein Gerät aus?" Style="{StaticResource H1}" />
                        <TextBlock x:Name="HeroText" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"
                                   Text="Der Lag-Scan misst einige Sekunden lang Prozessor, Arbeitsspeicher, Datenträger, Grafikkarte und Treiber-Latenzen und prüft deine Systemkonfiguration. Danach siehst du die Hauptverursacher und konkrete Lösungen – oft mit einem Klick behebbar. Tipp: Starte den Scan genau dann, wenn es ruckelt." />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="ScanButtonText" Text="Scan starten" />
                                </StackPanel>
                            </Button>
                            <ComboBox x:Name="DurationBox" Width="170" Margin="10,0,0,0">
                                <ComboBoxItem Content="Schnell (10 s)" Tag="10" />
                                <ComboBoxItem Content="Standard (20 s)" Tag="20" />
                                <ComboBoxItem Content="Gründlich (40 s)" Tag="40" />
                            </ComboBox>
                            <Button x:Name="CancelButton" Content="Abbrechen" Margin="10,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                            <Button x:Name="ExportButton" Margin="10,0,0,0" Visibility="Collapsed" Click="Export_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Bericht exportieren" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                            <DockPanel>
                                <TextBlock x:Name="ProgressLive" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ProgressText" />
                            </DockPanel>
                            <ProgressBar x:Name="Progress" Maximum="1" Margin="0,8,0,0" Height="8" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Ergebnisse ===== -->
            <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                <UniformGrid x:Name="StatsGrid" Columns="5" Margin="0,16,0,0" />

                <TextBlock Text="Ergebnisse &amp; Lösungen" Style="{StaticResource H2}" Margin="0,24,0,12" />
                <ItemsControl x:Name="FindingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="14,0,0,14" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Margin="18,16,0,0" VerticalAlignment="Top"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" Style="{StaticResource Icon}" FontSize="16"
                                                   HorizontalAlignment="Center" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="16,16,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Background="#252B3D" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0" />
                                        <Border Background="#121722" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                                Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" Foreground="#FBBF24" VerticalAlignment="Top" Margin="0,2,10,0" />
                                                <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,18,0">
                                        <Button Content="{Binding ActionLabel}" Click="FindingAction_Click" MinWidth="130"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                                IsEnabled="{Binding ActionDone, Converter={StaticResource InvBool}}" />
                                        <TextBlock Text="{Binding ActionStatus}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Hauptverursacher" Style="{StaticResource H2}" Margin="0,20,0,4" />
                <TextBlock Text="Programme mit dem grössten Einfluss auf die Leistung während der Messung" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                <Border Style="{StaticResource Card}" Padding="8,4">
                    <StackPanel>
                        <Grid Margin="10,10,10,8" TextElement.Foreground="{StaticResource SubTextBrush}" TextElement.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Programm" />
                            <TextBlock Grid.Column="1" Text="Ø CPU" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Spitze" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="RAM" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Datenträger" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="GPU" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineBrush}" />
                        <ItemsControl x:Name="CulpritsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel>
                                                <Image Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" FontSize="11" />
                                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,12,0"
                                                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding PeakText}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding RamText}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding IoText}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding GpuText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Verlauf ===== -->
            <StackPanel x:Name="HistoryPanel">
                <TextBlock Text="Verlauf" Style="{StaticResource H2}" Margin="0,24,0,12" />
                <Border Style="{StaticResource Card}" Padding="8,4">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="26" CornerRadius="8" HorizontalAlignment="Left" Background="{Binding Score, Converter={StaticResource ScoreBrush}}">
                                            <TextBlock Text="{Binding Score}" Foreground="#0E1016" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Rating}" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding TopIssue}" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
