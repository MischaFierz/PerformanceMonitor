<UserControl x:Class="PerformanceMonitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PerformanceMonitor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">
            <UniformGrid Columns="3">
                <c:MetricCard x:Name="CpuCard" Title="Prozessor" Glyph="&#xE9F5;" Accent="#22D3EE" Margin="0,0,8,16" />
                <c:MetricCard x:Name="RamCard" Title="Arbeitsspeicher" Glyph="&#xE81E;" Accent="#A78BFA" Margin="8,0,8,16" />
                <c:MetricCard x:Name="GpuCard" Title="Grafikkarte" Glyph="&#xE7FC;" Accent="#F472B6" Margin="8,0,0,16" />
                <c:MetricCard x:Name="DiskCard" Title="Datenträger" Glyph="&#xEDA2;" Accent="#FBBF24" Margin="0,0,8,16" />
                <c:MetricCard x:Name="NetCard" Title="Netzwerk" Glyph="&#xE839;" Accent="#34D399" SecondaryAccent="#60A5FA" Margin="8,0,8,16" />

                <!-- System & Energie -->
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="36" Height="36" CornerRadius="10" Background="#2660A5FA">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="16" Foreground="#60A5FA" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="System &amp; Energie" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="OsText" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Laufzeit" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock x:Name="UptimeText" Grid.Column="1" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="Prozesse / Handles" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProcText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="Treiber-Latenz (DPC)" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DpcText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Energieplan" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                        <ComboBox x:Name="PlanBox" SelectionChanged="PlanBox_SelectionChanged" />

                        <DockPanel Margin="0,14,0,0">
                            <CheckBox x:Name="BoostToggle" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" Click="Boost_Click" />
                            <StackPanel>
                                <TextBlock Text="Boost-Modus" FontWeight="SemiBold" />
                                <TextBlock Text="Maximale Leistung für Spiele &amp; Arbeit" Style="{StaticResource Caption}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top-Prozesse -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Alle Prozesse" Padding="12,5" FontSize="12" Click="AllProcesses_Click" />
                            <TextBlock Text="Aktivste Prozesse" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl x:Name="TopList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Value="{Binding Cpu, Mode=OneWay}" Maximum="100" Margin="12,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="{Binding RamText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Lag-Check -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A2238" Offset="0" />
                            <GradientStop Color="#221B3D" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lag-Check" Style="{StaticResource H2}" />
                        <TextBlock Text="Ruckelt dein PC? Der Scan findet die Ursache in wenigen Sekunden." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,16" />
                        <Grid Width="120" Height="120" HorizontalAlignment="Center">
                            <c:RingGauge x:Name="LastScanRing" Thickness="10" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="LastScanScore" Text="?" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="LastScanLabel" Text="Noch kein Scan" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LastScanTime" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="Scan_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Lag-Scan starten" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
