<UserControl x:Class="PerformanceMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Allgemein -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Allgemein" Style="{StaticResource H2}" Margin="0,0,0,14" />
                    <DockPanel Margin="0,0,0,14">
                        <CheckBox x:Name="AutostartToggle" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" Click="Autostart_Click" />
                        <StackPanel>
                            <TextBlock Text="Mit Windows starten" />
                            <TextBlock Text="PerfPulse startet minimiert im Infobereich und überwacht dein System." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <CheckBox x:Name="TrayToggle" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" Click="Setting_Changed" />
                        <StackPanel>
                            <TextBlock Text="Beim Schliessen in den Infobereich minimieren" />
                            <TextBlock Text="Die Überwachung und Warnungen laufen im Hintergrund weiter." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <CheckBox x:Name="MinimizedToggle" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" Click="Setting_Changed" />
                        <StackPanel>
                            <TextBlock Text="Minimiert starten" />
                            <TextBlock Text="Das Fenster wird beim Start nicht angezeigt." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Überwachung -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Überwachung" Style="{StaticResource H2}" Margin="0,0,0,14" />
                    <DockPanel>
                        <ComboBox x:Name="IntervalBox" DockPanel.Dock="Right" Width="170" Margin="16,0,0,0" SelectionChanged="Interval_Changed">
                            <ComboBoxItem Content="0,5 Sekunden" Tag="500" />
                            <ComboBoxItem Content="1 Sekunde" Tag="1000" />
                            <ComboBoxItem Content="2 Sekunden" Tag="2000" />
                            <ComboBoxItem Content="5 Sekunden" Tag="5000" />
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="Aktualisierungsintervall" />
                            <TextBlock Text="Kürzere Intervalle sind genauer, verbrauchen aber minimal mehr Ressourcen." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Warnungen -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Warnungen" Style="{StaticResource H2}" Margin="0,0,0,14" />
                    <DockPanel Margin="0,0,0,18">
                        <CheckBox x:Name="AlertsToggle" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" Click="Setting_Changed" />
                        <StackPanel>
                            <TextBlock Text="Benachrichtigung bei hoher Auslastung" />
                            <TextBlock Text="Zeigt eine Windows-Benachrichtigung mit dem Hauptverursacher an." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="CpuThresholdText" DockPanel.Dock="Right" FontWeight="SemiBold" />
                        <TextBlock Text="CPU-Schwelle" />
                    </DockPanel>
                    <Slider x:Name="CpuSlider" Minimum="50" Maximum="100" TickFrequency="5" ValueChanged="Slider_Changed" Margin="0,0,0,14" />

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="RamThresholdText" DockPanel.Dock="Right" FontWeight="SemiBold" />
                        <TextBlock Text="Arbeitsspeicher-Schwelle" />
                    </DockPanel>
                    <Slider x:Name="RamSlider" Minimum="50" Maximum="100" TickFrequency="5" ValueChanged="Slider_Changed" Margin="0,0,0,14" />

                    <DockPanel>
                        <ComboBox x:Name="DurationBox" DockPanel.Dock="Right" Width="170" SelectionChanged="Duration_Changed">
                            <ComboBoxItem Content="10 Sekunden" Tag="10" />
                            <ComboBoxItem Content="30 Sekunden" Tag="30" />
                            <ComboBoxItem Content="1 Minute" Tag="60" />
                            <ComboBoxItem Content="5 Minuten" Tag="300" />
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="Warnen nach" />
                            <TextBlock Text="Wie lange die Schwelle überschritten sein muss." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Über -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Image Source="/Assets/logo.png" Width="64" Height="64" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="PerfPulse" Style="{StaticResource H2}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
                        <TextBlock Text="Performance Monitor &amp; Lag-Analyse für Windows" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="AdminButton" Click="Admin_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Als Administrator neu starten" />
                                </StackPanel>
                            </Button>
                            <Button Click="DataFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Datenordner öffnen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
