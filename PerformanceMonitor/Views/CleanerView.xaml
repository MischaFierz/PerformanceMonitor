<UserControl x:Class="PerformanceMonitor.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">
            <!-- ===== Übersicht ===== -->
            <Border Style="{StaticResource Card}" Padding="28,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18213A" Offset="0" />
                        <GradientStop Color="#1F1A3A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AnalyzeButton" Click="Analyze_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Analysieren" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" Click="Clean_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Jetzt bereinigen" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TotalLabel" Text="Ausgewählt" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TotalText" Text="–" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Analysiere, wie viel Platz frei werden kann …" TextWrapping="Wrap" />
                        <ProgressBar x:Name="CleanProgress" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left" Width="520" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Optionen ===== -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Schnellauswahl" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <WrapPanel>
                            <Button Content="Alles auswählen" Padding="12,6" Margin="0,0,8,0" Tag="all" Click="QuickSelect_Click" />
                            <Button Content="Empfohlen" Padding="12,6" Margin="0,0,8,0" Tag="recommended" Click="QuickSelect_Click" />
                            <Button Content="Alle Caches" Padding="12,6" Margin="0,0,8,0" Tag="caches" Click="QuickSelect_Click" ToolTip="Alles ausser Papierkorb, Update-Dateien und Speicherabbildern" />
                            <Button Content="Nur Browser" Padding="12,6" Margin="0,0,8,0" Tag="browser" Click="QuickSelect_Click" />
                            <Button Content="Nichts" Padding="12,6" Tag="none" Click="QuickSelect_Click" />
                        </WrapPanel>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Dateien löschen, die älter sind als" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <ComboBox x:Name="AgeBox" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="Standard (empfohlen)" />
                                <ComboBoxItem Content="Alles löschen (auch neue)" Tag="0" />
                                <ComboBoxItem Content="1 Tag" Tag="24" />
                                <ComboBoxItem Content="7 Tage" Tag="168" />
                                <ComboBoxItem Content="30 Tage" Tag="720" />
                            </ComboBox>
                        </StackPanel>
                        <DockPanel Grid.Column="1" Margin="0,0,16,0">
                            <CheckBox x:Name="CloseAppsToggle" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Programme automatisch schliessen" />
                                <TextBlock Text="Browser &amp; Apps vorher beenden, damit wirklich alles gelöscht wird" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <CheckBox x:Name="EmptyFoldersToggle" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" IsChecked="True" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Leere Ordner entfernen" />
                                <TextBlock Text="Räumt übrig gebliebene leere Unterordner auf" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Kategorien ===== -->
            <ItemsControl x:Name="CategoryList" Margin="0,6,0,0">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="2,18,0,10" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="Selection_Click" IsEnabled="{Binding AdminMissing, Converter={StaticResource InvBool}}" />
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="#1F8B5CF6" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent2Brush}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <Border Background="#1AF59E0B" CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Admin" FontSize="11" Foreground="{StaticResource WarnBrush}" />
                                        </Border>
                                        <Border Background="#1A22C55E" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Empfohlen" FontSize="11" Foreground="{StaticResource GoodBrush}" />
                                        </Border>
                                        <Border Background="#1A60A5FA" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsAppRunning, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Das Programm läuft gerade. Gesperrte Dateien werden übersprungen – oder aktiviere „Programme automatisch schliessen“.">
                                            <TextBlock Text="läuft gerade" FontSize="11" Foreground="{StaticResource InfoBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="120">
                                    <TextBlock Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
