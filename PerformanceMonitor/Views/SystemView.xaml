<UserControl x:Class="PerformanceMonitor.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">
            <TextBlock x:Name="LoadingText" Text="Lade Systeminformationen …" Style="{StaticResource Caption}" Margin="0,20" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LeftColumn" />
                <StackPanel x:Name="RightColumn" Grid.Column="1" />
            </Grid>
            <TextBlock Text="Laufwerke" Style="{StaticResource H2}" Margin="0,12,0,12" />
            <ItemsControl x:Name="DriveList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#26FBBF24">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="17" Foreground="#FBBF24" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Background="#252B3D" CornerRadius="8" Padding="9,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" FontSize="14">
                                            <Run Text="{Binding Label, Mode=OneWay}" /> <Run Text="(" /><Run Text="{Binding Letter, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock x:Name="SysTag" Text="Systemlaufwerk" Style="{StaticResource Caption}" FontSize="11" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,16,0,8" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding UsageText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
