<UserControl x:Class="PerformanceMonitor.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,0,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1A22D3EE" CornerRadius="10" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ActiveCount" Text="–" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text=" aktiv" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TotalCount" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="Location_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Speicherort öffnen" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Aktualisieren" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border x:Name="AdminBanner" Grid.Row="1" Background="#1AF59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Als Administrator neu starten" Padding="12,6" Click="Admin_Click" />
                <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Einträge für „alle Benutzer“ können nur mit Administratorrechten geändert werden." />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4,6">
            <Grid>
                <DataGrid x:Name="Grid" RowHeight="46">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Aktiv" Width="80" SortMemberPath="IsEnabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="Toggle_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Programm" Width="1.6*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Herausgeber" Binding="{Binding Publisher}" Width="*" />
                        <DataGridTextColumn Header="Quelle" Binding="{Binding Location}" Width="*" />
                        <DataGridTextColumn Header="Befehl" Binding="{Binding Command}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                    <Setter Property="ToolTip" Value="{Binding Command}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="LoadingText" Text="Lade Autostart-Einträge …" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
