<UserControl x:Class="PerformanceMonitor.Views.BackgroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">
            <!-- ===== Übersicht ===== -->
            <Border Style="{StaticResource Card}" Padding="28,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18213A" Offset="0" />
                        <GradientStop Color="#1F1A3A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AnalyzeButton" Click="Analyze_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Neu analysieren" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" Click="CloseUnnecessary_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Unnötige beenden" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="HeadText" Text="Hintergrundprogramme werden analysiert …" Style="{StaticResource H1}" />
                        <TextBlock x:Name="SubText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Viele Programme laufen unsichtbar weiter – Updater, Launcher, Tray-Tools oder Browser ohne Fenster. Sie belegen Arbeitsspeicher und CPU und verlangsamen das System." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid x:Name="StatsGrid" Columns="3" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="Hintergrundprogramme" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatCount" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,4,0,0" />
                        <TextBlock x:Name="StatCountSub" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                    <StackPanel>
                        <TextBlock Text="Davon unnötig" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatUnnecessary" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,4,0,0" />
                        <TextBlock x:Name="StatUnnecessarySub" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Im Autostart" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatAutostart" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,4,0,0" />
                        <TextBlock Text="starten bei jedem Hochfahren automatisch" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Margin="0,20,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Unnötige auswählen" Padding="12,6" Margin="0,0,8,0" Click="SelectUnnecessary_Click" />
                    <Button x:Name="CloseSelectedButton" Style="{StaticResource DangerButton}" Padding="12,6" Click="CloseSelected_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock x:Name="CloseSelectedText" Text="Ausgewählte beenden" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="Gefundene Programme" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="Select_Click" IsEnabled="{Binding IsClosed, Converter={StaticResource InvBool}}" />
                                <Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" Margin="14,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <Border CornerRadius="8" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{Binding Verdict, Converter={StaticResource VerdictBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding VerdictText}" FontSize="11" Foreground="{Binding Verdict, Converter={StaticResource VerdictBrush}}" />
                                        </Border>
                                        <Border Background="#252B3D" CornerRadius="8" Padding="8,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
                                        </Border>
                                        <Border Background="#1FA78BFA" CornerRadius="8" Padding="8,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding InAutostart, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Autostart" FontSize="11" Foreground="{StaticResource Accent2Brush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RamText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="RAM" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CpuText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="CPU" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Margin="18,0,0,0" VerticalAlignment="Center" MinWidth="150">
                                    <Button Content="Beenden" Padding="12,5" Click="CloseOne_Click" IsEnabled="{Binding IsClosed, Converter={StaticResource InvBool}}" />
                                    <Button Content="Autostart aus" Padding="12,5" Margin="0,6,0,0" Click="DisableStartup_Click"
                                            Visibility="{Binding CanDisableStartup, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,30"
                       Text="Keine überflüssigen Hintergrundprogramme gefunden. 🎉" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
