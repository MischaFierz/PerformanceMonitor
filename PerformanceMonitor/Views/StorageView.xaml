<UserControl x:Class="PerformanceMonitor.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,0,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Suche ===== -->
        <Border Style="{StaticResource Card}" Padding="22,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#18213A" Offset="0" />
                    <GradientStop Color="#1F1A3A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <Border Background="#131722" CornerRadius="11" Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeLarge" Style="{StaticResource SegmentButton}" GroupName="StorageMode" Tag="&#xE8B7;"
                                     Content="Grosse Dateien" IsChecked="True" Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeDup" Style="{StaticResource SegmentButton}" GroupName="StorageMode" Tag="&#xE8C8;"
                                     Content="Duplikate" Checked="Mode_Checked" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ModeDescription" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />

                <WrapPanel Margin="0,14,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Suchen in" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ComboBox x:Name="ScopeBox" Width="280" SelectionChanged="ScopeBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Mindestgrösse" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ComboBox x:Name="MinSizeBox" Width="150" />
                    </StackPanel>
                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="Scan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Suche starten" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Content="Abbrechen" VerticalAlignment="Bottom" Margin="10,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                </WrapPanel>

                <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="Progress" Maximum="1" Margin="0,7,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Zusammenfassung ===== -->
        <DockPanel Grid.Row="1" Margin="0,16,0,10">
            <CheckBox x:Name="RareToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Content="Nur lange unveränderte (über 90 Tage)" Click="RareToggle_Click" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource H2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- ===== Ergebnislisten ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4,6">
            <Grid>
                <DataGrid x:Name="LargeGrid" RowHeight="50" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="50" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="Select_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Datei" Width="2.2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Grösse" Width="110" SortMemberPath="Size" SortDirection="Descending"
                                                CellStyle="{StaticResource HeatCell}" HeaderStyle="{StaticResource RightHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Size, Converter={StaticResource Heat}, ConverterParameter=10737418240}" Padding="12,0">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Zuletzt geändert" Width="130" SortMemberPath="LastUsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="T" Text="{Binding LastUsedText}" VerticalAlignment="Center" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRarelyUsed}" Value="True">
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Category}" Width="110" />
                        <DataGridTextColumn Header="Hinweis" Binding="{Binding Hint}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ItemsControl x:Name="DupList" Visibility="Collapsed" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="6,0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,4">
                                <Border Background="#1C2133" CornerRadius="8" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Padding="10,6" CornerRadius="6" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="Select_Click" />
                                                    <DockPanel Grid.Column="1">
                                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding LastUsedText}" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                                    <Border Grid.Column="4" Background="#1A22C55E" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="{Binding IsSuggestedKeep, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Original (behalten)" FontSize="11" Foreground="{StaticResource GoodBrush}" />
                                                    </Border>
                                                    <Button Grid.Column="5" Content="&#xE8B7;" FontFamily="{StaticResource IconFont}" Padding="10,6" ToolTip="Speicherort öffnen" Click="OpenItemLocation_Click" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#1A1F2E" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyGlyph" Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="40" Foreground="#3A4260" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Aktionen ===== -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AutoSelectButton" Margin="0,0,8,0" Click="AutoSelect_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE762;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Kopien automatisch auswählen" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" Click="ClearSelection_Click" Content="Auswahl aufheben" />
                <Button Margin="0,0,8,0" Click="OpenLocation_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Speicherort" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Click="Delete_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="In Papierkorb verschieben" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
        </DockPanel>
    </Grid>
</UserControl>
