<UserControl x:Class="PerformanceMonitor.Views.TemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PerformanceMonitor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">

            <!-- ===== Status ===== -->
            <Border x:Name="StatusCard" Style="{StaticResource Card}" Padding="24,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18213A" Offset="0" />
                        <GradientStop Color="#1F1A3A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#131722" CornerRadius="11" Padding="4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ViewAssembled" Style="{StaticResource SegmentButton}" GroupName="HwView" Tag="&#xE7F8;" Content="Zusammengebaut" IsChecked="True" Checked="View_Checked" />
                                <RadioButton x:Name="ViewExploded" Style="{StaticResource SegmentButton}" GroupName="HwView" Tag="&#xE8B3;" Content="Zerlegt" Checked="View_Checked" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="TestButton" Style="{StaticResource PrimaryButton}" Click="Test_Click" ToolTip="Belastet den Prozessor 30 Sekunden lang und prüft, wie gut die Kühlung arbeitet">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock x:Name="TestButtonText" Text="Wärmetest (30 s)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border x:Name="StatusIconBorder" Width="48" Height="48" CornerRadius="24" Background="#2622C55E" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusIcon" Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="22" Foreground="#22C55E" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Temperaturen werden gemessen …" Style="{StaticResource H1}" FontSize="21" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel x:Name="TestPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Abbrechen" Padding="12,5" Click="CancelTest_Click" />
                    <TextBlock x:Name="TestProgressText" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar x:Name="TestProgress" Maximum="1" Margin="0,8,0,0" Height="8" />
            </StackPanel>

            <!-- ===== Modell + Sensoren ===== -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,8,0">
                    <Border.Background>
                        <RadialGradientBrush Center="0.4,0.45" GradientOrigin="0.4,0.45" RadiusX="0.75" RadiusY="0.75">
                            <GradientStop Color="#1B2135" Offset="0" />
                            <GradientStop Color="#141824" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <c:HardwareVisual x:Name="Visual" Height="620" />
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6,0,0">
                            <TextBlock x:Name="DeviceTitle" Style="{StaticResource H2}" />
                            <TextBlock x:Name="DeviceSub" Style="{StaticResource Caption}" FontSize="11" Text="Fahre mit der Maus über ein Bauteil für Details" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="SensorCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="Sensoren" Style="{StaticResource H2}" />
                            </DockPanel>
                            <ItemsControl x:Name="SensorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,6" ToolTip="{Binding Source}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Text="  geschätzt" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"
                                                           Visibility="{Binding Estimated, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Background="#252B3D" Margin="0,5,0,0">
                                                <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="2" Background="{Binding Brush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ChartValue" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                <TextBlock Text="Prozessor-Temperatur" Style="{StaticResource H2}" />
                            </DockPanel>
                            <TextBlock Text="letzte 2 Minuten" Style="{StaticResource Caption}" FontSize="11" />
                            <c:LiveChart x:Name="TempChart" Height="110" Margin="0,8,0,0" Capacity="120" Stroke="#F97316" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ThrottleText" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                <TextBlock Text="Thermische Drosselung" Style="{StaticResource Caption}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Analyse ===== -->
            <TextBlock Text="Analyse &amp; Empfehlungen" Style="{StaticResource H2}" Margin="0,22,0,12" />
            <ItemsControl x:Name="AdviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="14,0,0,14" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Margin="16,14,0,14" VerticalAlignment="Top"
                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" Style="{StaticResource Icon}" FontSize="15"
                                               HorizontalAlignment="Center" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="14,13,16,13">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
