<Window x:Class="PerformanceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PerfPulse" Width="1340" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Seitenleiste ===== -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,26">
                        <Image Source="Assets/logo.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PerfPulse" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Performance Monitor" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Mini-Status unten -->
                    <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="14,12" CornerRadius="12"
                            Background="#161A26" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="MiniCpu" Text="–" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <ProgressBar x:Name="MiniCpuBar" Height="4" Maximum="100" Margin="0,5,0,10" />
                            <DockPanel>
                                <TextBlock Text="RAM" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="MiniRam" Text="–" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <ProgressBar x:Name="MiniRamBar" Height="4" Maximum="100" Margin="0,5,0,0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#A78BFA" Offset="0" />
                                        <GradientStop Color="#D946EF" Offset="1" />
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse x:Name="AdminDot" Width="7" Height="7" Fill="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="AdminText" Margin="7,0,0,0" Style="{StaticResource Caption}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                 CommandParameter="settings" Content="Einstellungen" Margin="12,0,12,12" Checked="Nav_Checked" />

                    <StackPanel>
                        <TextBlock Text="ÜBERSICHT" Style="{StaticResource Caption}" FontSize="10.5" Margin="30,0,0,6" />
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xEC4A;" CommandParameter="dashboard" Content="Dashboard" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavProcesses" Style="{StaticResource NavButton}" Tag="&#xE8FD;" CommandParameter="processes" Content="Prozesse" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavScan" Style="{StaticResource NavButton}" Tag="&#xE9D9;" CommandParameter="scan" Content="Lag-Scan" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavTemps" Style="{StaticResource NavButton}" Tag="&#xE706;" CommandParameter="temps" Content="Temperatur" Checked="Nav_Checked" />
                        <TextBlock Text="OPTIMIEREN" Style="{StaticResource Caption}" FontSize="10.5" Margin="30,18,0,6" />
                        <RadioButton x:Name="NavBackground" Style="{StaticResource NavButton}" Tag="&#xE7C4;" CommandParameter="background" Content="Hintergrund" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" Tag="&#xE7E8;" CommandParameter="startup" Content="Autostart" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavCleaner" Style="{StaticResource NavButton}" Tag="&#xE74D;" CommandParameter="cleaner" Content="Bereinigung" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavStorage" Style="{StaticResource NavButton}" Tag="&#xE8B7;" CommandParameter="storage" Content="Speicheranalyse" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" Tag="&#xE770;" CommandParameter="system" Content="Systeminfo" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Inhalt ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimieren" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximieren" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Schliessen" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="28,0,28,18">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0" />

                    <!-- Mitteilungen aus dem Admin-Bereich der Website -->
                    <ItemsControl x:Name="NotificationList" Margin="0,14,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="10" Margin="0,0,0,8" ClipToBounds="True">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="3" Background="{Binding Accent}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE711;" FontSize="10"
                                                Width="40" Height="40" VerticalAlignment="Top" ToolTip="Schliessen"
                                                Tag="{Binding Id}" Click="DismissNotification_Click" />
                                        <Button DockPanel.Dock="Right" Content="{Binding LinkText}" Tag="{Binding Link}" Click="NotificationLink_Click"
                                                VerticalAlignment="Center" Margin="12,0,0,0"
                                                Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16"
                                                   Foreground="{Binding Accent}" Margin="14,0,12,0" />
                                        <StackPanel Margin="0,10,0,10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>
